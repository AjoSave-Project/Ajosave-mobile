{
  "expo": {
    "name": "AjosaveMobile",
    "slug": "AjosaveMobile",
    "version": "3.2.1",
    "orientation": "portrait",
    "icon": "./assets/images/favicon.png",
    "scheme": "ajosavemobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/favicon.png"
      },
      "softwareKeyboardLayoutMode": "pan",
      "predictiveBackGestureEnabled": false,
      "package": "com.ajosave.AjosaveMobile"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "splash": {
      "image": "./assets/images/splash-minimal.png",
      "resizeMode": "contain",
      "backgroundColor": "#3d71d9ff"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Gilroy-Regular.ttf",
            "./assets/fonts/Gilroy-Medium.ttf",
            "./assets/fonts/Gilroy-SemiBold.ttf",
            "./assets/fonts/Gilroy-Bold.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "330f7f96-e937-497e-ad03-309e9a249b94"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
