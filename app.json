{
  "expo": {
    "name": "AjosaveMobile",
    "slug": "AjosaveMobile",
    "version": "3.2.1",
    "orientation": "portrait",
    "icon": "./assets/images/favicon.png",
    "scheme": "ajosavemobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/favicon.png"
      },
      "softwareKeyboardLayoutMode": "pan",
      "predictiveBackGestureEnabled": false,
      "package": "com.ajosave.AjosaveMobile"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-screen.png",
          "imageWidth": 200,
          "backgroundColor": "#F5F5F5",
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#F5F5F5"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Gilroy-Regular.ttf",
            "./assets/fonts/Gilroy-Medium.ttf",
            "./assets/fonts/Gilroy-SemiBold.ttf",
            "./assets/fonts/Gilroy-Bold.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8599fb1d-3b49-4772-af40-76d53a30ac63"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
